{
  "name": "extrator-de-telefones",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "tesseract-ocr": "^1.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.example.phoneextractor",
    "asarUnpack": [
      "**\\/*ffmpeg*\\/**"
    ],
    "icon": "assets/logo-phone-extractor.png",
    "mac": {
      "target": "dmg",
      "icon": "assets/logo-phone-extractor.icns"
    },
    "win": {
      "target": "nsis"
    }
  }
}
